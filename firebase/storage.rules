rules_version = '2';

// docs/Security.md §10 Storage rules table. Write is `false` everywhere
// admin-managed (products/categories/brands) rather than checking a role
// claim: every legitimate write happens either through a backend-issued,
// time-limited signed URL (modules/catalog/image-upload.service.ts) or the
// Admin SDK directly — both bypass these rules entirely. Role lives in
// Postgres, not a Firebase custom claim (AGENTS.md §3.3: never trust a JWT
// claim alone for authorization), so there's nothing reliable for a rule to
// check anyway — per docs/Architecture.md §5.4, "Storage rules are a second
// layer, not the only layer." Read is public for these paths, matching the
// storefront serving product imagery without auth.
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /brands/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Not built until the reviews phase — stubbed now per Security.md's
    // table so the rules file matches documented intent from day one.
    match /reviews/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Never public — signed URL only, issued by the backend after an
    // ownership check; Admin SDK writes bypass rules entirely.
    match /invoices/{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
