# GreenGrandMart — environment variables
# Copy to .env.local for local development. Never commit .env.local or any
# file containing real secrets. See docs/Environment_Config.md for the full
# reference (per-environment values, setup steps for each provider).

NODE_ENV=development

# ── Database (Neon Postgres) ────────────────────────────────────────────
# Local dev: docker compose up -d, then use the pooled/direct URLs below.
DATABASE_URL="postgresql://greengrandmart:greengrandmart@localhost:5433/greengrandmart"
DIRECT_DATABASE_URL="postgresql://greengrandmart:greengrandmart@localhost:5433/greengrandmart"

# ── Firebase — client config (public by design) ─────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY="demo-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="demo-greengrandmart.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="demo-greengrandmart"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="demo-greengrandmart.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
# true only in local dev, to point the client + admin SDKs at the emulator suite
NEXT_PUBLIC_FIREBASE_USE_EMULATOR="true"

# ── Firebase Admin SDK (server-only secret) ──────────────────────────────
# Not needed when NEXT_PUBLIC_FIREBASE_USE_EMULATOR=true, but must still be
# set to *some* value for env.ts to boot — the emulator ignores credentials.
FIREBASE_ADMIN_PROJECT_ID="demo-greengrandmart"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk@demo-greengrandmart.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nEMULATOR_PLACEHOLDER\n-----END PRIVATE KEY-----\n"

# ── Razorpay (server-only secrets; key ID is public) ─────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_not_configured"
RAZORPAY_WEBHOOK_SECRET="placeholder_not_configured"

# ── MSG91 (COD OTP only, server-only) ─────────────────────────────────────
MSG91_AUTH_KEY="placeholder_not_configured"
MSG91_OTP_TEMPLATE_ID="placeholder_not_configured"
MSG91_SENDER_ID="GRNMRT"

# ── Resend (transactional email, server-only) ─────────────────────────────
RESEND_API_KEY="placeholder_not_configured"
RESEND_FROM_EMAIL="orders@greengrandmart.example"

# ── App / Cron ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="local-dev-cron-secret"

# ── Observability (optional) ─────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ── Tax / seller config ───────────────────────────────────────────────────
DEFAULT_GST_RATE="0"
SELLER_STATE="Maharashtra"
SELLER_GSTIN="27AAAAA0000A1Z5"

# ── Business timing rules ─────────────────────────────────────────────────
RESERVATION_TTL_MINUTES="15"
OTP_EXPIRY_SECONDS="300"

# Pending PRD §14 decision — leave unset until the business confirms a value.
# COD_MAX_ORDER_VALUE=

# ── Shipping (flat rate + free-above-threshold, in paise) ────────────────
SHIPPING_FLAT_FEE="4900"
FREE_SHIPPING_THRESHOLD="99900"
